@model IndexModel
@{
    var filters = new (string Key, string Label)[]
    {
        ("all", Model.T("Tümü", "All")),
        ("backend", "Backend"),
        ("mobile", Model.T("Mobil", "Mobile")),
        ("web", "Web"),
        ("led", "LED")
    };
    var total = PortfolioContent.MoreProjects.Count;
    var transition = 0;
}
<section id="projects" class="section" aria-labelledby="projects-title">
    <div class="container">
        <header class="section-head section-head--row" data-reveal>
            <div>
                <p class="eyebrow"><span class="eyebrow__index">02</span>@Model.T("GitHub'daki diğer projeler", "More on GitHub")</p>
                <h2 id="projects-title" class="section-title">@Model.T("Canlı siteler, demolar ve bitirme projem", "Live sites, demos and my capstone")</h2>
            </div>
            <a class="btn btn--text" href="@PortfolioContent.GitHubReposUrl" target="_blank" rel="noopener">
                @Model.T("Tüm depolar", "All repositories") @Icons.ArrowUpRight
            </a>
        </header>

        <div class="filters" role="group" aria-label="@Model.T("Projeleri filtrele", "Filter projects")" data-filters data-reveal>
            @foreach (var f in filters)
            {
                <button class="filters__btn" type="button" data-filter="@f.Key" aria-pressed="@(f.Key == "all" ? "true" : "false")">@f.Label</button>
            }
            <span class="filters__count" aria-live="polite"><span data-filter-count>@total</span> @Model.T("proje", "projects")</span>
        </div>

        <ul class="project-grid">
            @foreach (var p in PortfolioContent.MoreProjects)
            {
                var repo = Model.GitHub.Find(p.RepoName);
                var repoUrl = repo?.Url ?? $"{PortfolioContent.GitHubUrl}/{p.RepoName}";
                var mainUrl = p.Live?.Url ?? (p.IsPrivate ? null : repoUrl);
                <li class="project @(p.Image is null ? "project--glyph" : "")" style="view-transition-name: project-@(transition++)" data-tags="@p.Tags" data-reveal data-tilt data-spot>
                    <div class="project__media" aria-hidden="@(p.Image is null ? "true" : "false")">
                        @if (p.Image is not null)
                        {
                            <img src="@p.Image.Src" width="@p.Image.Width" height="@p.Image.Height" alt="@Model.T(p.Image.Alt)" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <partial name="Sections/_Glyph" model="p.Glyph" />
                        }
                    </div>
                    <div class="project__body">
                        <p class="project__category">
                            <span>@Model.T(p.Category)</span>
                            @if (p.Status is not null)
                            {
                                <span class="badge badge--sm @Model.ToneClass(p.Status.Tone)">@Model.T(p.Status.Label)</span>
                            }
                        </p>
                        <h3 class="project__name">
                            @if (mainUrl is not null)
                            {
                                <a href="@mainUrl" target="_blank" rel="noopener" class="project__link">@p.Name</a>
                            }
                            else
                            {
                                @p.Name
                            }
                        </h3>
                        <p class="project__summary">@Model.T(p.Summary)</p>
                        <ul class="chips chips--sm">
                            @foreach (var tech in p.Stack)
                            {
                                <li>@tech</li>
                            }
                        </ul>
                        <div class="project__foot">
                            @if (p.IsPrivate)
                            {
                                <span class="project__repo">@Icons.Lock <span>@Model.T("Özel depo", "Private repository")</span></span>
                            }
                            else
                            {
                                <a class="project__repo" href="@repoUrl" target="_blank" rel="noopener">@Icons.GitHub <span>@p.RepoName</span></a>
                            }
                            @if (repo is { Stars: > 0 })
                            {
                                <span class="project__stars" title="GitHub stars">@Icons.Star @repo.Stars</span>
                            }
                            @if (p.Live is not null)
                            {
                                <a class="project__live" href="@p.Live.Url" target="_blank" rel="noopener">@Model.T(p.Live.Label) @Icons.ArrowUpRight</a>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>
